# 复制为 .env 后填写自己的 Key；.env 不要提交或分享
# 真实的环境变量优先于本文件（Docker / systemd / PM2 注入时无需 .env）

# ===== 上游 AI（OpenAI 兼容端点，可换任意供应商；文本与视觉可用不同厂商）=====
KIMI_API_KEY=sk-your-key-here
# 支持 http:// 与 https://；默认阿里云百炼，也可填 https://api.moonshot.cn/v1 等
KIMI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 文本模型：qwen3.7-flash（快速便宜，带 reasoning）；kimi-k2.7-code 亦可
KIMI_TEXT_MODEL=qwen3.7-flash
# 视觉模型必须用 vl 系列（qwen3.7-flash 不支持图片输入！）
VISION_API_KEY=sk-your-key-here
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-plus
# 上游账号每分钟请求数（服务端串行队列按此排队，默认 3）
KIMI_RPM=3
# 上游 429（账号并发限制/频率限制）时的最多尝试次数（含首次，1~10，默认 6）
# 退避：优先按上游 retry-after，缺失时指数增长（1s、1.5s、2.25s…指数上限 8s）；累计等待超过 40s 提前返回 429
AI_MAX_RETRIES=6

# ===== 监听 =====
# 127.0.0.1 = 仅本机访问（默认，最安全）
# 0.0.0.0   = 局域网/公网可访问（会打印暴露风险提示，务必配合限流与 HTTPS）
HOST=127.0.0.1
PORT=8080

# ===== /api/* 按客户端 IP 限流 =====
# 每个 IP 在窗口内最多请求次数；0 表示关闭限流
API_RATE_LIMIT=30
# 限流窗口（分钟）
API_RATE_WINDOW_MIN=10
# 1 = 位于 Nginx/Caddy 等可信反向代理后，从 X-Forwarded-For 首个 IP 取真实客户端 IP
# 直接对外暴露时请保持 0，否则客户端可伪造 X-Forwarded-For 绕过限流
TRUST_PROXY=0

# ===== 账号体系（v3.6：邮箱验证码注册/登录 + AI 每日额度）=====
# SMTP 邮件服务（465 端口隐式 TLS，仅用 Node 内置模块实现）。三项都填写后才可发送验证码；
# 未配置时 /api/auth/request-code 返回 503，AI 接口对所有人返回 401 LOGIN_REQUIRED。
# ⚠ QQ/163 等邮箱必须使用「授权码」而不是登录密码，且 MAIL FROM 必须等于 SMTP_USER（服务端已强制）。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-mail@example.com
SMTP_PASS=your-smtp-authorization-code
# 发件人显示名（默认「每日营养管家」）
MAIL_FROM_NAME=每日营养管家
# SQLite 数据库文件路径（留空 = 项目下 ./.data/app.db；Docker 内建议 /data/app.db 并挂载卷）
DATA_DIR=
# 仅本地调试：置 1 时把验证码打印到服务端日志（跳过真实收信即可联调）。生产务必注释掉！
# AUTH_DEV_LOG_CODE=1
