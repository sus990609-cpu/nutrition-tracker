# 复制为 .env 后填写自己的 Key；.env 不要提交或分享
# 真实的环境变量优先于本文件（Docker / systemd / PM2 注入时无需 .env）

# ===== 上游 AI（必填 Key）=====
KIMI_API_KEY=sk-your-key-here
# 支持 http:// 与 https://（自建反向代理或本地 mock 时可改成 http://127.0.0.1:xxxx/v1）
KIMI_BASE_URL=https://api.moonshot.cn/v1
# 实测可用模型：文本 kimi-k2.7-code（无法关闭思考，reasoning 占用 max_tokens）
#               视觉 kimi-k2.6（支持 thinking.type=disabled）
KIMI_TEXT_MODEL=kimi-k2.7-code
KIMI_VISION_MODEL=kimi-k2.6
# 上游账号每分钟请求数（服务端串行队列按此排队，默认 3）
KIMI_RPM=3
# 上游 429（账号并发限制/频率限制）时的最多尝试次数（含首次，1~10，默认 6）
# 退避：优先按上游 retry-after，缺失时指数增长（1s、1.5s、2.25s…指数上限 8s）；累计等待超过 40s 提前返回 429
AI_MAX_RETRIES=6

# ===== 监听 =====
# 127.0.0.1 = 仅本机访问（默认，最安全）
# 0.0.0.0   = 局域网/公网可访问（会打印暴露风险提示，务必配合限流与 HTTPS）
HOST=127.0.0.1
PORT=8080

# ===== /api/* 按客户端 IP 限流 =====
# 每个 IP 在窗口内最多请求次数；0 表示关闭限流
API_RATE_LIMIT=30
# 限流窗口（分钟）
API_RATE_WINDOW_MIN=10
# 1 = 位于 Nginx/Caddy 等可信反向代理后，从 X-Forwarded-For 首个 IP 取真实客户端 IP
# 直接对外暴露时请保持 0，否则客户端可伪造 X-Forwarded-For 绕过限流
TRUST_PROXY=0
